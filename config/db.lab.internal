$TTL 604800
@       IN      SOA     dns.lab.internal. admin.lab.internal. (
                        1         ; Serial
                        604800    ; Refresh
                        86400     ; Retry
                        2419200   ; Expire
                        604800 )  ; Negative Cache TTL
;
@       IN      NS      dns.lab.internal.
dns     IN      A       10.10.10.3
dhcp    IN      A       10.10.10.2
web     IN      A       10.10.10.4
ftp     IN      A       10.10.10.5
